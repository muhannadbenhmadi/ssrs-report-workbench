<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <ReportParameters>
    <ReportParameter Name="Year">
      <DataType>Text</DataType>
    </ReportParameter>
  </ReportParameters>
  <DataSets>
    <DataSet Name="Orders">
      <Query>
        <DataSourceName>Sales</DataSourceName>
        <CommandText>SELECT 1</CommandText>
      </Query>
      <Fields>
        <Field Name="Total"><DataField>Total</DataField></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportSections>
    <ReportSection>
      <Width>200in</Width>
      <Body>
        <Height>2in</Height>
        <ReportItems>
          <Textbox Name="Textbox1">
            <Paragraphs><Paragraph><TextRuns><TextRun>
              <Value>=Parameters!Region.Value</Value>
            </TextRun></TextRuns></Paragraph></Paragraphs>
          </Textbox>
          <Textbox Name="textbox1">
            <Paragraphs><Paragraph><TextRuns><TextRun>
              <Value>static</Value>
            </TextRun></TextRuns></Paragraph></Paragraphs>
          </Textbox>
        </ReportItems>
      </Body>
      <Page>
        <PageHeight>11in</PageHeight>
        <PageWidth>8.5in</PageWidth>
      </Page>
    </ReportSection>
  </ReportSections>
  <DataSources>
    <DataSource Name="AdventureWorks">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=localhost;Initial Catalog=Demo;Password=secret</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
</Report>
