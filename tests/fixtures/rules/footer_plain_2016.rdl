<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition">
  <Language>ar</Language>
  <ReportParameters>
    <ReportParameter Name="Code">
      <DataType>String</DataType>
      <Prompt>Code</Prompt>
    </ReportParameter>
  </ReportParameters>
  <ReportParametersLayout>
    <GridLayoutDefinition>
      <NumberOfColumns>4</NumberOfColumns>
      <NumberOfRows>1</NumberOfRows>
      <CellDefinitions>
        <CellDefinition>
          <ColumnIndex>0</ColumnIndex>
          <RowIndex>0</RowIndex>
          <ParameterName>Code</ParameterName>
        </CellDefinition>
      </CellDefinitions>
    </GridLayoutDefinition>
  </ReportParametersLayout>
  <ReportSections>
    <ReportSection>
      <Width>6.5in</Width>
      <Body>
        <Height>2in</Height>
        <ReportItems>
          <Textbox Name="SubtitleLabel">
            <Paragraphs><Paragraph><TextRuns><TextRun>
              <Value>الرمز:</Value>
              <Style><Direction>RTL</Direction></Style>
            </TextRun></TextRuns></Paragraph></Paragraphs>
          </Textbox>
          <Textbox Name="SubtitleValue">
            <Paragraphs><Paragraph><TextRuns><TextRun>
              <Value>=Parameters!Code.Value</Value>
              <Style><Direction>LTR</Direction></Style>
            </TextRun></TextRuns></Paragraph></Paragraphs>
          </Textbox>
        </ReportItems>
      </Body>
      <Page>
        <PageFooter>
          <Height>0.4in</Height>
          <PrintOnFirstPage>true</PrintOnFirstPage>
          <PrintOnLastPage>true</PrintOnLastPage>
          <ReportItems>
            <Textbox Name="PrintedLabel">
              <Paragraphs><Paragraph><TextRuns><TextRun>
                <Value>معتمد</Value>
                <Style><Direction>RTL</Direction></Style>
              </TextRun></TextRuns></Paragraph></Paragraphs>
            </Textbox>
            <Textbox Name="PrintedValue">
              <Paragraphs><Paragraph><TextRuns><TextRun>
                <Value>=Globals!ExecutionTime</Value>
                <Style><Direction>LTR</Direction></Style>
              </TextRun></TextRuns></Paragraph></Paragraphs>
            </Textbox>
          </ReportItems>
        </PageFooter>
        <PageHeight>11in</PageHeight>
        <PageWidth>8.5in</PageWidth>
        <LeftMargin>1in</LeftMargin>
        <RightMargin>1in</RightMargin>
      </Page>
    </ReportSection>
  </ReportSections>
</Report>
